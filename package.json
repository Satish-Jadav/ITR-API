{
  "name": "zerotax-api",
  "version": "2026.1.0",
  "description": "ZeroTax Production Node.js + Vercel Serverless API with Supabase & VAPT Hardening",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node init && tsx watch src/devServer.ts",
    "build": "node init && node scripts/db-push.js && npx tsc --noEmit",
    "vercel-build": "node scripts/db-push.js && npx tsc --noEmit",
    "lint": "tsc --noEmit",
    "generate-keys": "node scripts/generate-keys.js",
    "test": "tsx scripts/test-api.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "node scripts/db-push.js",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@google/genai": "^3.0.0",
    "@hono/node-server": "^1.13.7",
    "@hono/zod-validator": "^0.4.1",
    "@neondatabase/serverless": "^0.10.1",
    "@supabase/supabase-js": "^2.46.1",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.4",
    "google-auth-library": "^9.14.2",
    "hono": "^4.6.9",
    "jose": "^5.9.6",
    "node-fetch": "^3.3.2",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vercel": "^38.0.0"
  }
}
