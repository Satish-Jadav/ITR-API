# =============================================================================
# ZeroTax-Local API Production Environment Variables (bom1 / ap-south-1 Mumbai)
# =============================================================================

# Server Environment
NODE_ENV=production
PORT=3000
API_BASE_URL=https://api.zerotax.in

# -----------------------------------------------------------------------------
# 1. Supabase (Database & Storage in ap-south-1 Mumbai)
# -----------------------------------------------------------------------------
# Option A: Discrete Connection Variables (Recommended - avoids URL encoding issues)
DB_HOST=aws-0-ap-south-1.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.[PROJECT_REF]
DB_PASSWORD=your_database_password_here

# Option B: Single Connection String (Alternative)
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# Supabase Project API URL & Keys
SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY (client-safe)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# SUPABASE_SERVICE_ROLE_KEY (bypasses RLS, used strictly on backend for admin storage tasks)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Storage Bucket Names
SUPABASE_VAULT_BUCKET=ztvault-backups
SUPABASE_CA_BUCKET=ca-dossiers

# -----------------------------------------------------------------------------
# 2. Cryptographic Server Keys (Ed25519 for Access JWT & Statutory OTA Manifest)
# -----------------------------------------------------------------------------
# Generate via: npm run generate-keys
ZEROTAX_ED25519_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEIK...\n-----END PRIVATE KEY-----"
ZEROTAX_ED25519_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEA...\n-----END PUBLIC KEY-----"
ZEROTAX_OTA_SIGNING_PRIVATE_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ZEROTAX_OTA_PUBLIC_KEY_HEX=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210

# Blind Index HMAC Server Pepper (Never change once set in production!)
ZEROTAX_PAN_BLIND_INDEX_PEPPER=change_this_to_a_cryptographically_secure_64_byte_hex_pepper

# -----------------------------------------------------------------------------
# 3. Google Play Integrity & OAuth 2.1
# -----------------------------------------------------------------------------
# Google Cloud Service Account JSON for Play Integrity API verification
# Minified single-line string of the service account key
GOOGLE_PLAY_INTEGRITY_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"..."}
GOOGLE_PLAY_PACKAGE_NAME=in.zerotax.app
GOOGLE_PLAY_RELEASE_CERT_SHA256=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# Set to 'true' only in local development / emulators without Play Services
ALLOW_PLAY_INTEGRITY_DEV_BYPASS=false

# Google OAuth Web Client ID for validating Google Sign-In ID Tokens
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
